---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultBg from '../assets/properties/camelot-apartments/01.jpg';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
}
const { eyebrow, title, lead, image = defaultBg } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-brand-950">
  <Image src={image} alt="" widths={[800, 1200]} sizes="100vw" class="absolute inset-0 -z-10 size-full object-cover opacity-30" loading="eager" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-950 via-brand-950/85 to-brand-900/40"></div>
  <div class="container-x py-16 sm:py-20">
    {eyebrow && <p class="eyebrow !text-brand-300 animate-fade-up">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-4xl font-extrabold !text-white sm:text-5xl animate-fade-up">{title}</h1>
    {lead && <p class="mt-4 max-w-2xl text-lg text-brand-100/85 animate-fade-up">{lead}</p>}
    <slot />
  </div>
</section>
