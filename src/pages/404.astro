---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { company, url } from '../data/site';
---

<Layout title="Page not found">
  <section class="container-x flex flex-col items-center py-28 text-center">
    <p class="font-display text-8xl font-extrabold text-brand-100">404</p>
    <h1 class="mt-4 text-3xl font-extrabold sm:text-4xl">We couldn't find that page.</h1>
    <p class="mt-3 max-w-md text-slate-600">It may have moved when we updated our website. Try browsing rentals or give us a call.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={url()} class="btn btn-primary"><Icon name="home" class="size-4" /> Home</a>
      <a href={url('properties/')} class="btn btn-outline"><Icon name="search" class="size-4" /> Browse rentals</a>
      <a href={company.phoneHref} class="btn btn-outline"><Icon name="phone" class="size-4" /> {company.phone}</a>
    </div>
  </section>
</Layout>
