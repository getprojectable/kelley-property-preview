---
// Lightweight redirect used to keep legacy kelleyproperty.com URLs working.
import { url } from '../data/site';
interface Props { to: string }
const target = url(Astro.props.to);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
  </head>
  <body>
    <a href={target}>Continue to the new page</a>
  </body>
</html>
