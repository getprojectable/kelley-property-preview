---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { url } from '../data/site';

interface Props {
  property: CollectionEntry<'properties'>;
  eager?: boolean;
}
const { property, eager = false } = Astro.props;
const p = property.data;
const href = url(`properties/${property.id}/`);
---

<article
  class="property-card group relative flex h-full flex-col overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-900/10"
  data-city={p.city}
  data-type={p.type}
  data-beds={p.beds}
  data-baths={p.baths}
  data-features={p.features.join('|')}
  data-garage={String(p.garage)}
  data-title={p.title}
  data-id={property.id}>
  <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
    <Image
      src={p.images[0]}
      alt={`${p.title} exterior`}
      widths={[400, 640, 800]}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
      class="size-full object-cover transition duration-700 group-hover:scale-105"
      loading={eager ? 'eager' : 'lazy'}
    />
    <div class="absolute inset-x-0 top-0 flex items-start justify-between p-4">
      <span class="rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-ink shadow-sm backdrop-blur">{p.type}</span>
      {p.available && <span class="rounded-full bg-brand-600 px-3 py-1 text-xs font-semibold text-white shadow-sm">Available</span>}
    </div>
    <span class="absolute bottom-4 right-4 inline-flex items-center gap-1 rounded-full bg-black/55 px-2.5 py-1 text-xs font-medium text-white backdrop-blur">
      <Icon name="images" class="size-3.5" /> {p.images.length}
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-brand-600">
      <Icon name="pin" class="size-3.5" /> {p.city}, IA
    </p>
    <h3 class="mt-2 text-xl font-bold">
      <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">{p.title}</a>
    </h3>
    <p class="mt-1 text-sm text-slate-500">{p.address.split(',')[0]}</p>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600">{p.summary}</p>
    <div class="mt-auto pt-5">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-slate-100 pt-4 text-sm text-slate-700">
        {p.beds > 0 && <span class="flex items-center gap-1.5"><Icon name="bed" class="size-4 text-slate-400" /> {p.beds} Bed{p.beds > 1 && 's'}</span>}
        {p.baths > 0 && <span class="flex items-center gap-1.5"><Icon name="bath" class="size-4 text-slate-400" /> {p.baths} Bath{p.baths > 1 && 's'}</span>}
        {p.garage && <span class="flex items-center gap-1.5"><Icon name="car" class="size-4 text-slate-400" /> Garage</span>}
        {p.type === 'Commercial' && <span class="flex items-center gap-1.5"><Icon name="building" class="size-4 text-slate-400" /> Office / Retail</span>}
      </div>
      <div class="mt-4 flex items-center justify-between">
        <span class="font-semibold text-brand-700">{p.price}</span>
        <span class="inline-flex items-center gap-1 text-sm font-medium text-slate-500 transition group-hover:text-brand-700">Details <Icon name="arrow" class="size-4 transition group-hover:translate-x-0.5" /></span>
      </div>
    </div>
  </div>
</article>
