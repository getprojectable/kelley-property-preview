---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PropertyCard from '../components/PropertyCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, url } from '../data/site';
import heroImg from '../assets/properties/camelot-apartments/01.jpg';
import sideImg from '../assets/properties/village-1-bedroom-1-bath-units/01.jpg';
import sideImg2 from '../assets/properties/colonial-house/06.jpg';
import vacationImg from '../assets/vacation/waters-edge/04.jpg';

const all = await getCollection('properties');
const featured = all.filter((p) => p.data.featured).slice(0, 6);
const cities = ['Cedar Rapids', 'Marion', 'Hiawatha'] as const;
const cityCount = (c: string) => all.filter((p) => p.data.city === c).length;
const cityImage = {
  'Cedar Rapids': all.find((p) => p.id === 'lamplight-terrace')!.data.images[0],
  Marion: all.find((p) => p.id === 'wedgewood-apartments')!.data.images[0],
  Hiawatha: all.find((p) => p.id === 'camelot-apartments')!.data.images[0],
};
const types = [...new Set(all.map((p) => p.data.type))];

const reasons = [
  { icon: 'home', title: 'Something for Everyone', text: 'One-bedroom apartments to single-family homes — 1, 2 and 3 bedroom options in neighborhoods all over the metro.' },
  { icon: 'star', title: 'Best Rentals, Lowest Prices', text: 'We work hard to keep quality high and rents affordable in Cedar Rapids, Marion and Hiawatha.' },
  { icon: 'wrench', title: 'Responsive Maintenance', text: 'Submit a service request online any time and our maintenance team will get it taken care of.' },
  { icon: 'users', title: 'Locally Owned & Managed', text: 'Professional office and maintenance staff. Visit our main office for a private showing — no appointment necessary.' },
] as const;
---

<Layout>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-brand-950">
    <Image src={heroImg} alt="The Camelot apartments in Hiawatha" widths={[800, 1024]} sizes="100vw" class="absolute inset-0 -z-10 size-full object-cover" loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-950/95 via-brand-950/75 to-brand-950/20"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-brand-950/60 to-transparent"></div>

    <div class="container-x grid gap-12 pb-28 pt-20 sm:pt-28 lg:grid-cols-12 lg:pb-36">
      <div class="lg:col-span-7">
        <p class="eyebrow animate-fade-up !text-brand-300"><span class="h-px w-8 bg-brand-400"></span> Cedar Rapids · Marion · Hiawatha</p>
        <h1 class="mt-5 animate-fade-up text-4xl font-extrabold leading-[1.05] !text-white sm:text-6xl">
          Find a place that feels like <span class="text-brand-300">home</span>.
        </h1>
        <p class="mt-6 max-w-xl animate-fade-up text-lg leading-relaxed text-white/85 [animation-delay:120ms]">
          {`Quality apartments, townhomes and houses at prices that make sense. ${company.units} units and ${company.yearsInBusiness} years serving Eastern Iowa — we truly have `}<em>"{company.tagline}."</em>
        </p>
        <div class="mt-9 flex animate-fade-up flex-wrap gap-3 [animation-delay:200ms]">
          <a href={url('properties/')} class="btn btn-primary !px-7 !py-3.5 text-base">Browse Rentals <Icon name="arrow" class="size-4" /></a>
          <a href={company.phoneHref} class="btn btn-ghost-light !px-7 !py-3.5 text-base"><Icon name="phone" class="size-4" /> {company.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick search -->
  <section class="container-x relative z-10 -mt-16">
    <form action={url('properties/')} method="get" class="card grid gap-4 p-5 shadow-2xl shadow-brand-950/10 sm:grid-cols-2 sm:p-6 lg:grid-cols-[1fr_1fr_1fr_auto] lg:items-end">
      <div>
        <label for="q-city" class="field-label">Location</label>
        <select id="q-city" name="city" class="field">
          <option value="">Any location</option>
          {cities.map((c) => <option>{c}</option>)}
        </select>
      </div>
      <div>
        <label for="q-type" class="field-label">Property type</label>
        <select id="q-type" name="type" class="field">
          <option value="">Any type</option>
          {types.map((t) => <option>{t}</option>)}
        </select>
      </div>
      <div>
        <label for="q-beds" class="field-label">Bedrooms</label>
        <select id="q-beds" name="beds" class="field">
          <option value="">Any</option>
          <option value="1">1+</option>
          <option value="2">2+</option>
          <option value="3">3+</option>
        </select>
      </div>
      <button class="btn btn-primary h-[46px] sm:col-span-2 lg:col-span-1"><Icon name="search" class="size-4" /> Search</button>
    </form>
  </section>

  <!-- Stats -->
  <section class="container-x pt-16">
    <dl class="grid grid-cols-2 gap-6 text-center lg:grid-cols-4">
      {[
        [company.yearsInBusiness, 'Years in business'],
        [company.units, 'Units to choose from'],
        ['3', 'Communities served'],
        ['6', 'Days a week, in person'],
      ].map(([n, l], i) => (
        <div class="reveal flex flex-col" style={`transition-delay:${i * 80}ms`}>
          <dt class="order-2 mt-1 text-sm text-slate-500">{l}</dt>
          <dd class="font-display text-4xl font-extrabold text-brand-700 sm:text-5xl">{n}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Featured -->
  <section class="section">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="reveal">
          <p class="eyebrow">Featured Rentals</p>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Popular places to call home</h2>
        </div>
        <a href={url('properties/')} class="btn btn-outline reveal">View all {all.length} listings <Icon name="arrow" class="size-4" /></a>
      </div>
      <div class="mt-12 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((p, i) => <div class="reveal h-full" style={`transition-delay:${(i % 3) * 90}ms`}><PropertyCard property={p} /></div>)}
      </div>
    </div>
  </section>

  <!-- Why Kelley -->
  <section class="section bg-sand">
    <div class="container-x grid items-center gap-16 lg:grid-cols-2">
      <div class="reveal relative">
        <Image src={sideImg} alt="Village apartments with private balconies" widths={[600, 900]} sizes="(min-width:1024px) 45vw, 100vw" class="aspect-[4/3] w-full rounded-[2rem] object-cover shadow-2xl shadow-brand-950/15" />
        <Image src={sideImg2} alt="Living room at Colonial House" widths={[300, 500]} sizes="250px" class="absolute -bottom-10 -right-4 hidden aspect-square w-56 rounded-3xl border-8 border-sand object-cover shadow-xl sm:block" />
        <div class="absolute -left-4 top-8 hidden rounded-2xl bg-white p-4 shadow-xl sm:block">
          <p class="font-display text-3xl font-extrabold text-brand-700">{company.yearsInBusiness}</p>
          <p class="text-xs font-medium text-slate-500">years of quality,<br />price &amp; service</p>
        </div>
      </div>
      <div>
        <p class="eyebrow reveal">Why Kelley Properties</p>
        <h2 class="reveal mt-3 text-3xl font-extrabold sm:text-4xl">Quality, price and service have been our priority for over 30 years.</h2>
        <p class="reveal mt-5 text-lg leading-relaxed text-slate-600">
          We offer the best rentals at the lowest prices in the Cedar Rapids, Marion and Hiawatha area — with
          over 1,000 units, there's truly something for everyone.
        </p>
        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {reasons.map((r, i) => (
            <div class="reveal" style={`transition-delay:${i * 80}ms`}>
              <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-brand-600 text-white shadow-lg shadow-brand-700/25"><Icon name={r.icon} class="size-6" /></span>
              <h3 class="mt-4 text-lg font-bold">{r.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{r.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Areas -->
  <section class="section">
    <div class="container-x">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Neighborhoods</p>
        <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Rentals across the Corridor</h2>
        <p class="mt-4 text-slate-600">Close to I-380, Lindale Mall, Kirkwood, parks and bus routes — find the location that fits your life.</p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {cities.map((c, i) => (
          <a href={url(`properties/?city=${encodeURIComponent(c)}`)} class="reveal group relative isolate flex min-h-72 flex-col justify-end overflow-hidden rounded-3xl p-8 text-white shadow-lg transition hover:-translate-y-1 hover:shadow-2xl" style={`transition-delay:${i * 90}ms`}>
            <Image src={cityImage[c]} alt="" widths={[400, 700]} sizes="(min-width:768px) 33vw, 100vw" class="absolute inset-0 -z-10 size-full object-cover transition duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-brand-950/95 via-brand-950/50 to-transparent"></div>
            <p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-brand-200"><Icon name="pin" class="size-3.5" /> Iowa</p>
            <h3 class="mt-1 text-3xl font-bold !text-white">{c}</h3>
            <p class="mt-1 text-sm text-white/75">{cityCount(c)} listing{cityCount(c) === 1 ? '' : 's'} online</p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-200">Explore {c} <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Resident tools -->
  <section class="section bg-brand-950 text-brand-100/85">
    <div class="container-x">
      <div class="reveal max-w-2xl">
        <p class="eyebrow !text-brand-300">For Applicants &amp; Residents</p>
        <h2 class="mt-3 text-3xl font-extrabold !text-white sm:text-4xl">Everything you need, online.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {[
          { icon: 'file', title: 'Apply Online', text: 'Start your rental application online or download the tenant and co-signer forms.', href: 'apply/', cta: 'Start application' },
          { icon: 'wrench', title: 'Service Request', text: 'Something need fixing? Submit a maintenance request in just a couple of minutes.', href: 'service-request/', cta: 'Request service' },
          { icon: 'mail', title: 'Contact the Office', text: 'Questions about availability or pricing? Send us a message or give us a call.', href: 'contact/', cta: 'Get in touch' },
        ].map((c, i) => (
          <a href={url(c.href)} class="reveal group rounded-3xl border border-white/10 bg-white/5 p-8 transition hover:-translate-y-1 hover:bg-white/10" style={`transition-delay:${i * 90}ms`}>
            <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-brand-500/20 text-brand-300"><Icon name={c.icon as any} class="size-6" /></span>
            <h3 class="mt-6 text-xl font-bold !text-white">{c.title}</h3>
            <p class="mt-2 text-sm leading-relaxed">{c.text}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand-300">{c.cta} <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Vacation teaser -->
  <section class="section">
    <div class="container-x">
      <a href={url('vacation-rentals/')} class="reveal group relative isolate flex min-h-[26rem] items-end overflow-hidden rounded-[2rem] p-8 shadow-2xl shadow-sky-950/20 sm:p-14">
        <Image src={vacationImg} alt="Pool at The Water's Edge in Key West" widths={[800, 1280]} sizes="(min-width:1280px) 1200px, 100vw" class="absolute inset-0 -z-10 size-full object-cover transition duration-700 group-hover:scale-105" />
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-sky-950/90 via-sky-950/60 to-transparent"></div>
        <div class="max-w-lg">
          <p class="eyebrow !text-amber-200"><Icon name="sun" class="size-4" /> Tropical Vacation Rentals</p>
          <h2 class="mt-3 text-3xl font-extrabold !text-white sm:text-5xl">Trade Iowa winters for Key West sunsets.</h2>
          <p class="mt-4 text-white/85">Two private homes near Duval Street with pools and ocean-view decks, plus condos and investment opportunities in Belize.</p>
          <span class="btn mt-8 bg-white text-sky-900 group-hover:bg-amber-50">Explore vacation rentals <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" /></span>
        </div>
      </a>
    </div>
  </section>

  <CtaBand />
</Layout>
