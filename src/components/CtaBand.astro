---
import Icon from './Icon.astro';
import { company, url } from '../data/site';
---

<section class="container-x pb-20 sm:pb-28">
  <div class="reveal relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-brand-700 via-brand-800 to-brand-950 px-8 py-14 text-center shadow-2xl shadow-brand-900/20 sm:px-16">
    <div class="pointer-events-none absolute -left-24 -top-24 size-72 rounded-full bg-brand-400/25 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -right-24 size-72 rounded-full bg-brand-300/20 blur-3xl"></div>
    <h2 class="relative text-3xl font-extrabold !text-white sm:text-4xl">Ready to find your next home?</h2>
    <p class="relative mx-auto mt-4 max-w-xl text-brand-100/90">
      Our leasing team is here six days a week. Call, stop by the office, or start your application today.
    </p>
    <div class="relative mt-8 flex flex-wrap justify-center gap-3">
      <a href={company.phoneHref} class="btn btn-light"><Icon name="phone" class="size-4" /> {company.phone}</a>
      <a href={url('apply/')} class="btn btn-ghost-light"><Icon name="file" class="size-4" /> Apply Now</a>
      <a href={url('properties/')} class="btn btn-ghost-light"><Icon name="search" class="size-4" /> Browse Rentals</a>
    </div>
  </div>
</section>
